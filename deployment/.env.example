# Zoneflow production settings - TEMPLATE ONLY (names, no values).
# The real file lives OUTSIDE the repository, e.g. C:\ZoneflowData\zoneflow.env, and is never committed or shared.
# Install-Zoneflow.ps1 creates it; tools/create_zoneflow_admin.py fills in the four login values.

# --- login (written by tools/create_zoneflow_admin.py) ---
ZONEFLOW_ADMIN_USERNAME=
ZONEFLOW_ADMIN_PASSWORD_HASH=
ZONEFLOW_SESSION_SECRET=
ZONEFLOW_PROXY_TOKEN=

# --- public address ---
ZONEFLOW_DOMAIN=
ZONEFLOW_PUBLIC_BASE_URL=

# --- runtime ---
ZONEFLOW_AUTH_MODE=proxy
ZONEFLOW_AUTH_PORT=8601
ZONEFLOW_APP_PORT=8501
ZONEFLOW_AUTH_STATE_DIR=
ZONEFLOW_LOG_DIR=
TV_WORKSPACE_DATA=
TV_MT5_COMMON_FILES=
ZONEFLOW_TELEMETRY_ROOT=
