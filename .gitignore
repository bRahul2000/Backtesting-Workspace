venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
htmlcov/
*.log
.DS_Store
.env
.env.*
!.env.example
# real Zoneflow production settings (deployment/.env.example is the template)
*.env
zoneflow.env*
!deployment/.env.example
.streamlit/secrets.toml
.streamlit/secrets.*
secrets.*
*.pem
*.key

# User-supplied Exness tick archives stay local; keep the directory scaffold.
/data/exness/raw/*
!/data/exness/raw/.gitkeep

# MT5 compiles scripts next to their source; the binaries are terminal output.
*.ex5

# R4 digital-twin audit exports (generated / MT5 terminal output)
data/exness/btc/r4/

# Fresh broker re-exports for provenance checking (terminal output, large)
data/exness/btc/provenance/raw/
data/exness/btc/provenance/processed/

# Zoneflow telemetry store, reconciliation results and watchdog state (production: C:\ZoneflowData\telemetry)
data/telemetry/

# Stage 3 live-forward evidence collected from the terminal
data/exness/btc/stage3/
data/exness/btc/stage4/

# Alternative virtualenv layout.
.venv/

# Agent/tooling scratch space; never part of the repository.
scratchpad/
.scratchpad/

# Temporary and editor artefacts.
*.tmp
*.temp
*.bak
*.swp
*~

# Log directories (bare *.log is already covered above).
logs/
log/

# The experiment ledger is a local run artefact: it grows with every backtest,
# differs per machine, and is reproducible from the research modules. The other
# experiments/*.sqlite3 files are small committed research records and stay.
experiments/experiments.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Feed comparison lab: downloaded Binance history and large per-candle outputs stay local.
research/feed_comparison/cache/
research/feed_comparison/output/*_*.csv

# TradingView Mode workspace chart history (refreshed closed bars; never research data)
/data/workspace/

# a node_modules symlink (e.g. in a git worktree) is ignored like the directory
node_modules
