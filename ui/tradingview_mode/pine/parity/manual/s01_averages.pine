//@version=6
// Pine parity MANUAL script for fixture `s01_averages` (table). Generated from fixtures.py - do not edit.
// Same calculations as fixtures/s01_averages.pine; the values are shown in a table (TradingView Basic plan).
indicator("parity s01_averages (manual)", overlay=true, precision=8)
// ---- fixture data: a pure function of bar_index; the chart's own prices are NOT used ----
// Every price is a multiple of 0.25, so TradingView and the local engine start from identical values.
fxClose(int i) =>
    int kk = i % 240
    int noise = (kk * 37 + 11) % 17 - 8
    int tri = kk % 80 < 40 ? kk % 80 : 80 - kk % 80
    float amp = kk >= 150 and kk < 170 ? 8.0 : 1.0
    kk >= 210 and kk < 222 ? 110.0 : 100.0 + tri * 0.5 + noise * 0.25 * amp
fxWick(int kk, int mult, int add, int m) =>
    kk >= 211 and kk < 222 ? 0.0 : ((kk * mult + add) % m) * 0.25
int k = bar_index % 240
float c = fxClose(bar_index)
float o = bar_index == 0 ? c - 0.5 : fxClose(bar_index - 1)
bool topTie = k == 184 or k == 186 or k == 190 or k == 191 or k == 196 or k == 199
bool bottomTie = k == 203 or k == 205 or k == 226 or k == 227
float h = topTie ? 120.0 : k % 37 == 0 ? math.max(o, c) : math.max(o, c) + fxWick(k, 53, 5, 13)
float l = bottomTie ? 95.0 : k % 37 == 0 ? math.min(o, c) : math.min(o, c) - fxWick(k, 29, 3, 11)
float v = 100.0 + ((k * 29) % 41) * 5
// ---- end of fixture data ----
float v_sma5 = ta.sma(c, 5)
float v_sma20 = ta.sma(c, 20)
float v_ema1 = ta.ema(c, 1)
float v_ema9 = ta.ema(c, 9)
float v_ema20 = ta.ema(c, 20)
float v_rma14 = ta.rma(c, 14)
float v_wma10 = ta.wma(c, 10)
float gappy = k % 23 >= 20 ? na : c
float v_sma5_gappy = ta.sma(gappy, 5)
float v_ema9_gappy = ta.ema(gappy, 9)
float v_rma14_gappy = ta.rma(gappy, 14)
float v_wma10_gappy = ta.wma(gappy, 10)
// ---- manual parity table (TradingView only) ----
int page = input.int(0, "Page", minval=0, maxval=3, tooltip="0: bars 0-9 warm-up: first sma5 at bar 4, ema9 at 8, wma10 at 9 | 1: bars 10-19 first rma14 at 13, first sma20 / ema20 at 19 | 2: bars 17-26 na source values at bars 20-22 (gappy columns) | 3: bars 150-159 sudden volatility (bars 150-169)")
int part = input.int(1, "Columns", minval=1, maxval=2, tooltip="1: sma5, sma20, ema1, ema9, ema20, rma14 | 2: wma10, sma5_gappy, ema9_gappy, rma14_gappy, wma10_gappy")
int firstBarInput = input.int(-1, "First bar (-1 = use Page)", minval=-1)
int pageStart = switch page
    0 => 0
    1 => 10
    2 => 17
    3 => 150
    => 0
int firstBar = firstBarInput >= 0 ? firstBarInput : pageStart
var table grid = table.new(position.top_right, 7, 12, bgcolor=color.white, border_color=color.gray, border_width=1, frame_color=color.gray, frame_width=1)
put(int col, int row, string txt) =>
    table.cell(grid, col, row, txt, text_color=color.black, text_size=size.normal, text_halign=text.align_right)
fmt(float value) => na(value) ? "na" : str.tostring(value, "0.########")
if barstate.isfirst
    put(0, 0, "s01_averages · columns " + str.tostring(part) + " · bars " + str.tostring(firstBar) + "-" + str.tostring(firstBar + 9))
    table.merge_cells(grid, 0, 0, 6, 0)
    put(0, 1, "bar")
    if part == 1
        put(1, 1, "sma5")
        put(2, 1, "sma20")
        put(3, 1, "ema1")
        put(4, 1, "ema9")
        put(5, 1, "ema20")
        put(6, 1, "rma14")
    if part == 2
        put(1, 1, "wma10")
        put(2, 1, "sma5_gappy")
        put(3, 1, "ema9_gappy")
        put(4, 1, "rma14_gappy")
        put(5, 1, "wma10_gappy")
int row = bar_index - firstBar + 2
if row >= 2 and row <= 11
    put(0, row, str.tostring(bar_index))
    if part == 1
        put(1, row, fmt(v_sma5))
        put(2, row, fmt(v_sma20))
        put(3, row, fmt(v_ema1))
        put(4, row, fmt(v_ema9))
        put(5, row, fmt(v_ema20))
        put(6, row, fmt(v_rma14))
    if part == 2
        put(1, row, fmt(v_wma10))
        put(2, row, fmt(v_sma5_gappy))
        put(3, row, fmt(v_ema9_gappy))
        put(4, row, fmt(v_rma14_gappy))
        put(5, row, fmt(v_wma10_gappy))
plot(bar_index, "bi", display=display.data_window)
