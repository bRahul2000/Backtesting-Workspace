//@version=5
// Pine parity MANUAL script for fixture `s09_loops_v5` (table). Generated from fixtures.py - do not edit.
// Same calculations as fixtures/s09_loops_v5.pine; the values are shown in a table (TradingView Basic plan).
indicator("parity s09_loops_v5 (manual)", overlay=true, precision=8)
// ---- fixture data: a pure function of bar_index; the chart's own prices are NOT used ----
// Every price is a multiple of 0.25, so TradingView and the local engine start from identical values.
fxClose(int i) =>
    int kk = i % 240
    int noise = (kk * 37 + 11) % 17 - 8
    int tri = kk % 80 < 40 ? kk % 80 : 80 - kk % 80
    float amp = kk >= 150 and kk < 170 ? 8.0 : 1.0
    kk >= 210 and kk < 222 ? 110.0 : 100.0 + tri * 0.5 + noise * 0.25 * amp
fxWick(int kk, int mult, int add, int m) =>
    kk >= 211 and kk < 222 ? 0.0 : ((kk * mult + add) % m) * 0.25
int k = bar_index % 240
float c = fxClose(bar_index)
float o = bar_index == 0 ? c - 0.5 : fxClose(bar_index - 1)
bool topTie = k == 184 or k == 186 or k == 190 or k == 191 or k == 196 or k == 199
bool bottomTie = k == 203 or k == 205 or k == 226 or k == 227
float h = topTie ? 120.0 : k % 37 == 0 ? math.max(o, c) : math.max(o, c) + fxWick(k, 53, 5, 13)
float l = bottomTie ? 95.0 : k % 37 == 0 ? math.min(o, c) : math.min(o, c) - fxWick(k, 29, 3, 11)
float v = 100.0 + ((k * 29) % 41) * 5
// ---- end of fixture data ----
float sum10 = 0.0
for i = 0 to 9
    sum10 += c[i]
float v_for_sum10 = sum10
int evens = 0
for i = 10 to 0 by 2
    evens += i
float v_for_desc_by2 = evens
int firstUp = -1
for i = 0 to 20
    if nz(c[i]) - nz(o[i]) <= 0
        continue
    firstUp := i
    break
float v_for_break = firstUp
int steps = 0
float x = c
while x > 100
    x -= 3.5
    steps += 1
float v_while_steps = steps
int limit = 3
int iters = 0
for i = 0 to limit
    iters += 1
    if i == 1
        limit := 6
float v_for_dynamic_end = iters
lastVal = for i = 0 to 4
    i * 2
float v_for_value = lastVal
d = 7 / 2
float v_div_const = d
float v_div_series = bar_index / 2
bool lazy = bar_index % 2 == 0 and ta.cum(1) % 4 == 0
float v_and_stateful = lazy ? 1 : 0
// ---- manual parity table (TradingView only) ----
int page = input.int(0, "Page", minval=0, maxval=1, tooltip="0: bars 0-9 first bars | 1: bars 10-19 later bars")
int part = input.int(1, "Columns", minval=1, maxval=2, tooltip="1: for_dynamic_end, div_const, and_stateful, for_value, for_desc_by2 | 2: for_sum10, for_break, while_steps, div_series")
int firstBarInput = input.int(-1, "First bar (-1 = use Page)", minval=-1)
int pageStart = switch page
    0 => 0
    1 => 10
    => 0
int firstBar = firstBarInput >= 0 ? firstBarInput : pageStart
var table grid = table.new(position.top_right, 6, 12, bgcolor=color.white, border_color=color.gray, border_width=1, frame_color=color.gray, frame_width=1)
put(int col, int row, string txt) =>
    table.cell(grid, col, row, txt, text_color=color.black, text_size=size.normal, text_halign=text.align_right)
fmt(float value) => na(value) ? "na" : str.tostring(value, "0.########")
if barstate.isfirst
    put(0, 0, "s09_loops_v5 · columns " + str.tostring(part) + " · bars " + str.tostring(firstBar) + "-" + str.tostring(firstBar + 9))
    table.merge_cells(grid, 0, 0, 5, 0)
    put(0, 1, "bar")
    if part == 1
        put(1, 1, "for_dynamic_end")
        put(2, 1, "div_const")
        put(3, 1, "and_stateful")
        put(4, 1, "for_value")
        put(5, 1, "for_desc_by2")
    if part == 2
        put(1, 1, "for_sum10")
        put(2, 1, "for_break")
        put(3, 1, "while_steps")
        put(4, 1, "div_series")
int row = bar_index - firstBar + 2
if row >= 2 and row <= 11
    put(0, row, str.tostring(bar_index))
    if part == 1
        put(1, row, fmt(v_for_dynamic_end))
        put(2, row, fmt(v_div_const))
        put(3, row, fmt(v_and_stateful))
        put(4, row, fmt(v_for_value))
        put(5, row, fmt(v_for_desc_by2))
    if part == 2
        put(1, row, fmt(v_for_sum10))
        put(2, row, fmt(v_for_break))
        put(3, row, fmt(v_while_steps))
        put(4, row, fmt(v_div_series))
plot(bar_index, "bi", display=display.data_window)
