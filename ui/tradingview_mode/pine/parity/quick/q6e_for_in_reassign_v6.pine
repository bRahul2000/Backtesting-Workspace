//@version=6
// Pine P2.2-A2 parity - FOR...IN OBSERVATION ORACLE (v6), companion E: reassigning the ITERATED ARRAY VARIABLE
// (`a := array.from(...)`) inside the loop - different from mutating the object. Separate because Pine may reject
// it at compile time or stop at run time; either message IS the result. Any chart works.
indicator("q6e for...in iterated variable reassigned v6", overlay=true)
sq(array<int> a) =>
    string out = "na"
    if not na(a)
        out := "["
        if array.size(a) > 0
            for k = 0 to array.size(a) - 1
                out += str.tostring(array.get(a, k)) + " "
        out += "]"
    out

var table t = table.new(position.top_right, 2, 4, bgcolor=color.white, border_color=color.gray, border_width=1)
put(int col, int row, string txt) =>
    table.cell(t, col, row, txt, text_color=color.black, text_size=size.small, text_halign=text.align_left)
if barstate.islast
    array<int> a = array.from(1, 2, 3)
    string seq = ""
    int n = 0
    for x in a
        if n == 0
            a := array.from(7, 8, 9, 10)
        seq += str.tostring(x) + " "
        n += 1
    put(0, 0, "q6e ITERATED VARIABLE REASSIGNED (v6) - observed")
    table.merge_cells(t, 0, 0, 1, 0)
    put(0, 1, "a = [1,2,3]; for x in a: a := [7,8,9,10] in 1st iteration")
    put(1, 1, "iterations " + str.tostring(n) + " | x sequence: " + seq + "| a after: " + sq(a))
plot(close, "close", display=display.none)
