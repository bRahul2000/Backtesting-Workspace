//@version=6
// Pine P2.2 parity - OBSERVATION ORACLE, companion D: == / != between arrays.
// Separate because array equality may not compile; if TradingView reports a compiler error, that exact message
// IS the result (do not work around it). Any chart works (e.g. BINANCE:BTCUSDT 1m).
indicator("q5d array equality", overlay=true)

var array<float> v1 = array.new_float()
var array<float> v1alias = v1                   // persistent alias of the same array
array<float> x1 = array.new_float()
array<float> x1alias = x1                       // same-execution alias
array<float> x2 = array.new_float()
array<float> x3 = array.new_float()             // a separate array; both get the identical contents [5]
array.push(x2, 5)
array.push(x3, 5)                               // identical contents [5]

bool aliasEq = x1 == x1alias
bool aliasNe = x1 != x1alias
bool identicalEq = x2 == x3
bool identicalNe = x2 != x3
bool varAliasEq = v1 == v1alias

var table t = table.new(position.top_right, 2, 7, bgcolor=color.white, border_color=color.gray, border_width=1)
put(int col, int row, string txt) =>
    table.cell(t, col, row, txt, text_color=color.black, text_size=size.small, text_halign=text.align_left)
if barstate.islast
    put(0, 0, "q5d ARRAY EQUALITY - observed")
    table.merge_cells(t, 0, 0, 1, 0)
    put(0, 1, "same-execution alias  x1 == x1alias")
    put(1, 1, aliasEq ? "true" : "false")
    put(0, 2, "same-execution alias  x1 != x1alias")
    put(1, 2, aliasNe ? "true" : "false")
    put(0, 3, "separate, identical [5]  x2 == x3")
    put(1, 3, identicalEq ? "true" : "false")
    put(0, 4, "separate, identical [5]  x2 != x3")
    put(1, 4, identicalNe ? "true" : "false")
    put(0, 5, "persistent alias  v1 == v1alias (last bar)")
    put(1, 5, varAliasEq ? "true" : "false")
plot(close, "close", display=display.none)
