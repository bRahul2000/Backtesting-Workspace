if bar_index == 14
    qp_key2 := q_s05_hib5
var float qp_key3 = na
if bar_index == 5
    qp_key3 := q_s11_na_max
var table qp_table = table.new(position.top_right, 6, 27, bgcolor=color.white, border_color=color.gray, border_width=1, frame_color=color.gray, frame_width=1)
qp_put(int col, int row, string txt, color bg) =>
    table.cell(qp_table, col, row, txt, text_color=color.black, bgcolor=bg, text_size=size.normal)
if barstate.islast
    qp_put(0, 0, "PINE P1 QUICK PARITY · q1_main_v6" + (qp_inject ? " · SELF-TEST (1 failure expected)" : ""), color.white)
    table.merge_cells(qp_table, 0, 0, 5, 0)
    qp_put(0, 1, "tolerance: |TV - ours| <= 0.000000005 + 0.000000000001 x |ours|; na must match na", color.white)
    table.merge_cells(qp_table, 0, 1, 5, 1)
    qp_put(0, 2, "fixture", color.silver)
    qp_put(1, 2, "cells expected", color.silver)
    qp_put(2, 2, "checked", color.silver)
    qp_put(3, 2, "failed", color.silver)
    qp_put(4, 2, "max |diff|", color.silver)
    qp_put(5, 2, "RESULT", color.silver)
    int qp_allFail = 0
    bool qp_complete = true
    int qp_c0 = array.get(qp_count, 0)
    int qp_f0 = array.get(qp_fail, 0)
    bool qp_ok0 = qp_f0 == 0 and qp_c0 == 350
    qp_allFail += qp_f0
    qp_complete := qp_complete and qp_c0 == 350
    qp_put(0, 3, "s00_data", color.white)
    qp_put(1, 3, "350", color.white)
    qp_put(2, 3, str.tostring(qp_c0), color.white)
    qp_put(3, 3, str.tostring(qp_f0), color.white)
    qp_put(4, 3, qp_text(array.get(qp_maxdiff, 0)), color.white)
    qp_put(5, 3, qp_ok0 ? "PASS" : qp_c0 < 350 ? "INCOMPLETE" : "FAIL", qp_ok0 ? color.lime : color.red)
    int qp_c1 = array.get(qp_count, 1)
    int qp_f1 = array.get(qp_fail, 1)
    bool qp_ok1 = qp_f1 == 0 and qp_c1 == 1404
    qp_allFail += qp_f1
    qp_complete := qp_complete and qp_c1 == 1404
    qp_put(0, 4, "s05_extremes", color.white)
    qp_put(1, 4, "1404", color.white)
    qp_put(2, 4, str.tostring(qp_c1), color.white)
    qp_put(3, 4, str.tostring(qp_f1), color.white)
    qp_put(4, 4, qp_text(array.get(qp_maxdiff, 1)), color.white)
    qp_put(5, 4, qp_ok1 ? "PASS" : qp_c1 < 1404 ? "INCOMPLETE" : "FAIL", qp_ok1 ? color.lime : color.red)
    int qp_c2 = array.get(qp_count, 2)
    int qp_f2 = array.get(qp_fail, 2)
