    qp_put(0, 14, array.size(qp_fbar) == 0 ? "no failures" : "FIRST FAILURES", color.silver)
    table.merge_cells(qp_table, 0, 14, 5, 14)
    qp_put(0, 15, "bar", color.silver)
    qp_put(1, 15, "field", color.silver)
    qp_put(2, 15, "TV", color.silver)
    qp_put(3, 15, "ours", color.silver)
    qp_put(4, 15, "diff", color.silver)
    for qp_j = 0 to array.size(qp_fbar) - 1
        if array.size(qp_fbar) > 0
            qp_put(0, 16 + qp_j, array.get(qp_fbar, qp_j), color.white)
            qp_put(1, 16 + qp_j, array.get(qp_ffield, qp_j), color.white)
            qp_put(2, 16 + qp_j, array.get(qp_ftv, qp_j), color.white)
            qp_put(3, 16 + qp_j, array.get(qp_fours, qp_j), color.white)
            qp_put(4, 16 + qp_j, array.get(qp_fdiff, qp_j), color.white)
plot(bar_index, "bi", display=display.data_window)
