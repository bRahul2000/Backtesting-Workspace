    qp_put(1, 5, "1404", color.white)
    qp_put(2, 5, str.tostring(qp_c2), color.white)
    qp_put(3, 5, str.tostring(qp_f2), color.white)
    qp_put(4, 5, qp_text(array.get(qp_maxdiff, 2)), color.white)
    qp_put(5, 5, qp_ok2 ? "PASS" : qp_c2 < 1404 ? "INCOMPLETE" : "FAIL", qp_ok2 ? color.lime : color.red)
    int qp_c3 = array.get(qp_count, 3)
