//@version=6
// Pine parity QUICK CHECK `q1_main_v6`: data, extremes, pivots, var (historical), control flow, na.
// Generated by `python -m ui.tradingview_mode.pine.parity` from fixtures.py and this engine's output - do not edit.
// TradingView computes the fixture values itself; they are compared with the embedded expected values
// of the local Pine engine. Add to ANY chart with at least 240 bars; read the table (top right).
indicator("parity quick q1_main_v6", overlay=true)
// ---- fixture data: a pure function of bar_index; the chart's own prices are NOT used ----
// Every price is a multiple of 0.25, so TradingView and the local engine start from identical values.
fxClose(int i) =>
    int kk = i % 240
    int noise = (kk * 37 + 11) % 17 - 8
    int tri = kk % 80 < 40 ? kk % 80 : 80 - kk % 80
    float amp = kk >= 150 and kk < 170 ? 8.0 : 1.0
    kk >= 210 and kk < 222 ? 110.0 : 100.0 + tri * 0.5 + noise * 0.25 * amp
fxWick(int kk, int mult, int add, int m) =>
    kk >= 211 and kk < 222 ? 0.0 : ((kk * mult + add) % m) * 0.25
int k = bar_index % 240
float c = fxClose(bar_index)
float o = bar_index == 0 ? c - 0.5 : fxClose(bar_index - 1)
bool topTie = k == 184 or k == 186 or k == 190 or k == 191 or k == 196 or k == 199
bool bottomTie = k == 203 or k == 205 or k == 226 or k == 227
float h = topTie ? 120.0 : k % 37 == 0 ? math.max(o, c) : math.max(o, c) + fxWick(k, 53, 5, 13)
float l = bottomTie ? 95.0 : k % 37 == 0 ? math.min(o, c) : math.min(o, c) - fxWick(k, 29, 3, 11)
float v = 100.0 + ((k * 29) % 41) * 5
// ---- end of fixture data ----
// ---- s00_data ----
float q_s00_o = o
float q_s00_h = h
float q_s00_l = l
float q_s00_c = c
float q_s00_v = v
// ---- s05_extremes ----
float tp = switch bar_index % 24
    0 => 3.0
    1 => 5.0
    2 => 5.0
    3 => 2.0
    4 => 6.0
    5 => 6.0
    6 => 6.0
    7 => 1.0
    8 => 4.0
    9 => 7.0
    10 => 2.0
    11 => 7.0
    12 => 3.0
    13 => 9.0
    14 => 1.0
    15 => 1.0
    16 => 9.0
    17 => 2.0
    18 => 4.0
    19 => 8.0
    20 => 3.0
    21 => 4.0
    22 => 8.0
    23 => 1.0
    => na

float q_s05_tp = tp
float q_s05_hi3 = ta.highest(tp, 3)
float q_s05_lo3 = ta.lowest(tp, 3)
float q_s05_hi5 = ta.highest(tp, 5)
float q_s05_lo5 = ta.lowest(tp, 5)
float q_s05_hib3 = ta.highestbars(tp, 3)
float q_s05_lob3 = ta.lowestbars(tp, 3)
float q_s05_hib5 = ta.highestbars(tp, 5)
float q_s05_lob5 = ta.lowestbars(tp, 5)
float q_s05_hi10_h = ta.highest(h, 10)
float q_s05_lo10_l = ta.lowest(l, 10)
float q_s05_hib10_h = ta.highestbars(h, 10)
float q_s05_lob10_l = ta.lowestbars(l, 10)
// ---- s06_pivots ----

float q_s06_tp = tp
float q_s06_ph11 = ta.pivothigh(tp, 1, 1)
float q_s06_pl11 = ta.pivotlow(tp, 1, 1)
float q_s06_ph22 = ta.pivothigh(tp, 2, 2)
float q_s06_pl22 = ta.pivotlow(tp, 2, 2)
float q_s06_ph33 = ta.pivothigh(tp, 3, 3)
float q_s06_pl33 = ta.pivotlow(tp, 3, 3)
float q_s06_ph21 = ta.pivothigh(tp, 2, 1)
float q_s06_pl13 = ta.pivotlow(tp, 1, 3)
float q_s06_ph22_h = ta.pivothigh(h, 2, 2)
float q_s06_pl22_l = ta.pivotlow(l, 2, 2)
float q_s06_ph33_h = ta.pivothigh(h, 3, 3)
float q_s06_pl33_l = ta.pivotlow(l, 3, 3)
// ---- s07_var_varip ----
var int count = 0
count += 1
float q_s07_var_count = count
varip int ipCount = 0
ipCount += 1
float q_s07_varip_count = ipCount
var float lastCross = na
if ta.crossover(ta.ema(c, 5), ta.sma(c, 20))
    lastCross := c
float q_s07_var_last_cross = lastCross
var int sinceReset = 0
sinceReset := k % 50 == 0 ? 0 : sinceReset + 1
float q_s07_var_resets = sinceReset
counter() =>
    var int n = 0
    n += 1
    n
float q_s07_udf_var_a = counter()
float q_s07_udf_var_b = k % 2 == 0 ? counter() : -1
float plain = 0.0
plain += 1
float q_s07_no_var = plain
// ---- s10_control ----
int dirSwitch = switch
    c > o => 1
    c < o => -1
    => 0
float q_s10_switch_nosubject = dirSwitch
float bucket = switch k % 4
    0 => 10.0
    1 => 20.0
    2 => 30.0
    => na
float q_s10_switch_subject = bucket
float q_s10_ternary_chain = c > o ? 1 : c < o ? -1 : 0
float q_s10_ternary_na = c > 110 ? c : na
spread(float a, float b, float scale = 1.0) =>
    float d = a - b
    d * scale
float q_s10_udf_default = spread(h, l)
float q_s10_udf_arg = spread(h, l, 0.5)
bands(float src, int len) =>
    float mid = ta.sma(src, len)
    float dev = ta.stdev(src, len)
    [mid, mid + 2 * dev, mid - 2 * dev]
[m1, u1, l1] = bands(c, 10)
float q_s10_tuple_mid = m1
float q_s10_tuple_up = u1
float q_s10_tuple_lo = l1
[m2, u2, l2] = bands(h, 5)
float q_s10_tuple2_up = u2
int sgn = if c > o
    1
else
    -1
float q_s10_if_expr = sgn
float noElse = if k % 3 == 0
    c
float q_s10_if_noelse_na = noElse
// ---- s11_na ----
float a = k % 5 == 0 ? na : c
float q_s11_gappy = a
float q_s11_nz_default = nz(a)
float q_s11_nz_repl = nz(a, -1)
float q_s11_is_na = na(a) ? 1 : 0
float q_s11_fixnan = fixnan(a)
float q_s11_na_plus = a + 1
float q_s11_na_compare = a > 100 ? 1 : 0
float q_s11_na_max = math.max(a, 105)
float q_s11_na_hist = a[1]
float q_s11_na_change = ta.change(a)
float q_s11_cum_nz = ta.cum(nz(a))
float q_s11_na_highest = ta.highest(a, 3)
// ---- quick parity check (TradingView only) ----
bool qp_inject = input.bool(false, "Self-test: corrupt one expected value (must FAIL)")
float QP_ABS = 0.000000005
float QP_REL = 0.000000000001
var array<int> qp_count = array.new<int>(6, 0)
var array<int> qp_fail = array.new<int>(6, 0)
var array<float> qp_maxdiff = array.new<float>(6, 0.0)
var array<string> qp_fbar = array.new<string>()
var array<string> qp_ffield = array.new<string>()
var array<string> qp_ftv = array.new<string>()
var array<string> qp_fours = array.new<string>()
var array<string> qp_fdiff = array.new<string>()
qp_text(float value) => na(value) ? "na" : str.tostring(value, "0.############")
qp_same(float tv, float expected) =>
    (na(tv) and na(expected)) or (not na(tv) and not na(expected) and math.abs(tv - expected) <= QP_ABS + QP_REL * math.abs(expected))
qp_check(int fx, string field, float tv, string expectedText) =>
    float expected = str.tonumber(expectedText)
    if qp_inject and fx == 0 and array.get(qp_count, 0) == 0
        expected := nz(expected) + 0.001
    bool ok = qp_same(tv, expected)
    array.set(qp_count, fx, array.get(qp_count, fx) + 1)
    if not na(tv) and not na(expected)
        array.set(qp_maxdiff, fx, math.max(array.get(qp_maxdiff, fx), math.abs(tv - expected)))
    if not ok
        array.set(qp_fail, fx, array.get(qp_fail, fx) + 1)
        if array.size(qp_fbar) < 10
            array.push(qp_fbar, str.tostring(bar_index))
            array.push(qp_ffield, field)
            array.push(qp_ftv, qp_text(tv))
            array.push(qp_fours, qp_text(expected))
            array.push(qp_fdiff, na(tv) or na(expected) ? "na vs value" : qp_text(math.abs(tv - expected)))
    ok
