    qp_put(5, 9, qp_allFail == 0 and qp_complete ? "PASS" : "FAIL", qp_allFail == 0 and qp_complete ? color.lime : color.red)
    qp_put(0, 10, "KEY s06_pivots ph33 @ bar 19", color.white)
