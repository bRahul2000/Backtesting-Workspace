    qp_check(1, "5m g-off la-off globalDep", r_tf5_goff_loff_11, (pos5 == 4 ? ec5_11 : ep5_11))
    qp_check(2, "5m g-off la-on direct", r_tf5_goff_lon_0, (pos5 == 0 ? ec5_0 : ec5_0))
