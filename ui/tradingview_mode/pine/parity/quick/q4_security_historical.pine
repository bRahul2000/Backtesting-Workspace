    qp_put(5, 26, qp_obs10 == "CCCCC" ? "same" : "DIFFERENT", qp_obs10 == "CCCCC" ? color.white : color.red)
    string qp_obs11 = qp_pattern(11, 5)
    qp_put(0, 27, "5m gaps_on lookahead_off (single call)", color.white)
    table.merge_cells(qp_table, 0, 27, 2, 27)
    qp_put(3, 27, qp_obs11, color.white)
    qp_put(4, 27, "nnnnC", color.white)
    qp_put(5, 27, qp_obs11 == "nnnnC" ? "same" : "DIFFERENT", qp_obs11 == "nnnnC" ? color.white : color.red)
    string qp_obs12 = qp_pattern(12, 5)
    qp_put(0, 28, "5m gaps_on lookahead_on (single call)", color.white)
    table.merge_cells(qp_table, 0, 28, 2, 28)
    qp_put(3, 28, qp_obs12, color.white)
    qp_put(4, 28, "Cnnnn", color.white)
    qp_put(5, 28, qp_obs12 == "Cnnnn" ? "same" : "DIFFERENT", qp_obs12 == "Cnnnn" ? color.white : color.red)
    qp_put(0, 29, array.size(qp_ftime) == 0 ? "no failures" : "FIRST FAILURES", color.silver)
    table.merge_cells(qp_table, 0, 29, 5, 29)
    qp_put(0, 30, "chart time (UTC)", color.silver)
    qp_put(1, 30, "case", color.silver)
    qp_put(2, 30, "TV", color.silver)
    qp_put(3, 30, "expected", color.silver)
    qp_put(4, 30, "diff", color.silver)
    for qp_j = 0 to array.size(qp_ftime) - 1
        if array.size(qp_ftime) > 0
            qp_put(0, 31 + qp_j, array.get(qp_ftime, qp_j), color.white)
            qp_put(1, 31 + qp_j, array.get(qp_fcase, qp_j), color.white)
            qp_put(2, 31 + qp_j, array.get(qp_ftv, qp_j), color.white)
            qp_put(3, 31 + qp_j, array.get(qp_fexp, qp_j), color.white)
            qp_put(4, 31 + qp_j, array.get(qp_fdiff, qp_j), color.white)
plot(bar_index, "bi", display=display.data_window)
