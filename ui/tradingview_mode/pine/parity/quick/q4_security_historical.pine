    qp_check(2, "5m g-off la-on closeLike", r_tf5_goff_lon_10, (pos5 == 0 ? ec5_10 : ec5_10))
    qp_check(2, "5m g-off la-on globalDep", r_tf5_goff_lon_11, (pos5 == 0 ? ec5_11 : ec5_11))
