//@version=5
// Pine P2.2-A2 parity - FOR...IN OBSERVATION ORACLE (v5), companion R: cases that may STOP the script with a
// runtime error. Choose ONE case with the "Case" input (settings); only that case runs, so an error in one case
// cannot hide the others. If the chart shows a runtime error, its exact text IS the result for that case.
// Setup: any chart (BINANCE:BTCUSDT 1m preferred). No prices are used.
indicator("q6r for...in runtime cases v5", overlay=true)
caseSel = input.int(4, "Case: 4 = Q4 push, 5 = Q5 pop, 6 = Q6 shift, 7 = Q7 remove ahead, 8 = Q8 clear, 10 = Q10 na array", options=[4, 5, 6, 7, 8, 10])
sq(array<int> a) =>
    string out = "na"
    if not na(a)
        out := "["
        if array.size(a) > 0
            for k = 0 to array.size(a) - 1
                out += str.tostring(array.get(a, k)) + " "
        out += "]"
    out

var table t = table.new(position.top_right, 2, 4, bgcolor=color.white, border_color=color.gray, border_width=1)
put(int col, int row, string txt) =>
    table.cell(t, col, row, txt, text_color=color.black, text_size=size.small, text_halign=text.align_left)

if barstate.islast
    string label = ""
    string seq = ""
    int n = 0
    string after = ""
    if caseSel == 4
        label := "Q4 [1,2,3], push 4 in 1st iteration"
        array<int> a = array.from(1, 2, 3)
        for x in a
            if n == 0
                array.push(a, 4)
            seq += str.tostring(x) + " "
            n += 1
        after := sq(a)
    if caseSel == 5
        label := "Q5 [1,2,3,4], pop in 1st iteration"
        array<int> a = array.from(1, 2, 3, 4)
        for x in a
            if n == 0
                array.pop(a)
            seq += str.tostring(x) + " "
            n += 1
        after := sq(a)
    if caseSel == 6
        label := "Q6 [1,2,3,4], shift in 1st iteration"
        array<int> a = array.from(1, 2, 3, 4)
        for x in a
            if n == 0
                array.shift(a)
            seq += str.tostring(x) + " "
            n += 1
        after := sq(a)
    if caseSel == 7
        label := "Q7 for [i, x] in [1,2,3,4,5], remove index 3 when i == 1"
        array<int> a = array.from(1, 2, 3, 4, 5)
        for [i, x] in a
            if i == 1
                array.remove(a, 3)
            seq += str.tostring(i) + ":" + str.tostring(x) + " "
            n += 1
        after := sq(a)
    if caseSel == 8
        label := "Q8 [1,2,3,4], clear in 1st iteration"
        array<int> a = array.from(1, 2, 3, 4)
        for x in a
            if n == 0
                array.clear(a)
            seq += str.tostring(x) + " "
            n += 1
        after := sq(a)
    if caseSel == 10
        label := "Q10 array<int> a = na; for x in a"
        array<int> a = na
        for x in a
            seq += str.tostring(x) + " "
            n += 1
        after := na(a) ? "na" : sq(a)
    put(0, 0, "q6r FOR...IN RUNTIME CASE (v5) - observed")
    table.merge_cells(t, 0, 0, 1, 0)
    put(0, 1, label)
    put(1, 1, "completed | iterations " + str.tostring(n) + " | sequence: " + seq + "| array after: " + after)
plot(close, "close", display=display.none)
