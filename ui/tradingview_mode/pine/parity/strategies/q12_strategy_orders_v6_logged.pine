//@version=6
// Zoneflow P3.1 parity - STRATEGY ORACLE q12: order timing, brackets, trailing stops, reversal, pyramiding.
// Real TradingView is the oracle. Chart: BINANCE:BTCUSDT.P, 1D (the whole history loads), any chart timezone.
// Result: Strategy Tester -> "List of trades" -> Download (CSV). Scenarios run on fixed UTC dates, one after another,
// each flattened before the next; every trade's entry ID names its scenario.
strategy("q12 strategy orders", overlay=true, initial_capital=1000000, default_qty_type=strategy.fixed,
     default_qty_value=1, margin_long=0, margin_short=0)
on(int y, int m, int d) => time == timestamp("UTC", y, m, d, 0, 0)

// S1 market entry and market close: both fill at the next bar's open
if on(2025, 1, 4)
    strategy.entry("S1", strategy.long)
if on(2025, 1, 5)
    strategy.close_all()
// S2 / S3 bracket (+/-5000 ticks) on the entry bar: open nearer the high (S2) and nearer the low (S3)
if on(2025, 1, 12)
    strategy.entry("S2", strategy.long)
    strategy.exit("S2x", "S2", profit = 5000, loss = 5000)
if on(2025, 1, 19)
    strategy.entry("S3", strategy.long)
    strategy.exit("S3x", "S3", profit = 5000, loss = 5000)
// S4 trailing stop, activation 10 ticks, offset 1000 ticks, on an entry bar whose open is nearer the high
if on(2025, 2, 3)
    strategy.entry("S4", strategy.long)
    strategy.exit("S4t", "S4", trail_points = 10, trail_offset = 1000)
if on(2025, 2, 6)
    strategy.close_all()
// S5 trailing stop, offset 5000 ticks, on an entry bar whose open is nearer the low and whose close is near the high
if on(2025, 2, 11)
    strategy.entry("S5", strategy.long)
    strategy.exit("S5t", "S5", trail_points = 10, trail_offset = 5000)
if on(2025, 2, 16)
    strategy.close_all()
// S7 reversal: a long in loss is reversed by a short entry; an exit without from_entry is placed on the same bar
if on(2025, 2, 20)
    strategy.entry("S7L", strategy.long)
if on(2025, 2, 23)
    strategy.entry("S7S", strategy.short)
    strategy.exit("S7x", trail_points = 10, trail_offset = 100)
if on(2025, 3, 1)
    strategy.close_all()
// S8 two market entries with different IDs on one bar, default pyramiding (1)
if on(2025, 3, 20)
    strategy.entry("S8a", strategy.long)
    strategy.entry("S8b", strategy.long)
if on(2025, 3, 22)
    strategy.close_all()
// S9 buy limit above the market; S10 buy stop below the market
if on(2025, 3, 26)
    strategy.entry("S9", strategy.long, limit = close + 2000)
if on(2025, 3, 28)
    strategy.close_all()
if on(2025, 4, 1)
    strategy.entry("S10", strategy.long, stop = close - 2000)
if on(2025, 4, 3)
    strategy.close_all()
// S11 the same entry ID placed again with a new limit price
if on(2025, 4, 6)
    strategy.entry("S11", strategy.long, limit = close - 20000)
if on(2025, 4, 7)
    strategy.entry("S11", strategy.long, limit = close - 1000)
if on(2025, 4, 10)
    strategy.close_all()
// S6 trailing stop across many bars: activation 20000 ticks, offset 30000 ticks
if on(2025, 4, 21)
    strategy.entry("S6", strategy.long)
    strategy.exit("S6t", "S6", trail_points = 20000, trail_offset = 30000)
if on(2025, 5, 25)
    strategy.close_all()
// S13 strategy.close(immediately = true) on the entry bar
if on(2025, 6, 2)
    strategy.entry("S13", strategy.long)
if on(2025, 6, 3)
    strategy.close("S13", immediately = true)
plot(strategy.position_size, "position size", display = display.data_window)

// ==== ZF observation block (added for Pine Logs; read-only: no order, setting or input changes) ====
// Emits one machine-readable Pine Logs line per trade on the last confirmed historical bar, prefix ZF|Q12|.
zfNum(float v) => na(v) ? "na" : str.tostring(v, "#.########")
zfDate(int t) => na(t) ? "na" : str.tostring(year(t, "UTC")) + "-" + (month(t, "UTC") < 10 ? "0" : "") + str.tostring(month(t, "UTC")) + "-" + (dayofmonth(t, "UTC") < 10 ? "0" : "") + str.tostring(dayofmonth(t, "UTC"))
if barstate.islastconfirmedhistory
    int zfClosed = strategy.closedtrades
    int zfOpen = strategy.opentrades
    log.info("ZF|Q12|BEGIN|closed=" + str.tostring(zfClosed) + "|open=" + str.tostring(zfOpen) + "|last_bar_time=" + str.tostring(time) + "|mintick=" + zfNum(syminfo.mintick))
    if zfClosed > 0
        for i = 0 to zfClosed - 1
            log.info("ZF|Q12|TRADE|" + str.tostring(i) + "|entry_id=" + strategy.closedtrades.entry_id(i) + "|size=" + zfNum(strategy.closedtrades.size(i)) + "|entry_time=" + str.tostring(strategy.closedtrades.entry_time(i)) + "|entry_bar=" + str.tostring(strategy.closedtrades.entry_bar_index(i)) + "|entry_price=" + zfNum(strategy.closedtrades.entry_price(i)) + "|exit_id=" + strategy.closedtrades.exit_id(i) + "|exit_time=" + str.tostring(strategy.closedtrades.exit_time(i)) + "|exit_bar=" + str.tostring(strategy.closedtrades.exit_bar_index(i)) + "|exit_price=" + zfNum(strategy.closedtrades.exit_price(i)) + "|profit=" + zfNum(strategy.closedtrades.profit(i)) + "|commission=" + zfNum(strategy.closedtrades.commission(i)) + "|runup=" + zfNum(strategy.closedtrades.max_runup(i)) + "|drawdown=" + zfNum(strategy.closedtrades.max_drawdown(i)))
    if zfOpen > 0
        for i = 0 to zfOpen - 1
            log.info("ZF|Q12|OPEN|" + str.tostring(i) + "|entry_id=" + strategy.opentrades.entry_id(i) + "|size=" + zfNum(strategy.opentrades.size(i)) + "|entry_time=" + str.tostring(strategy.opentrades.entry_time(i)) + "|entry_bar=" + str.tostring(strategy.opentrades.entry_bar_index(i)) + "|entry_price=" + zfNum(strategy.opentrades.entry_price(i)))
    log.info("ZF|Q12|SUMMARY|initial=" + zfNum(strategy.initial_capital) + "|equity=" + zfNum(strategy.equity) + "|net=" + zfNum(strategy.netprofit) + "|gross_profit=" + zfNum(strategy.grossprofit) + "|gross_loss=" + zfNum(strategy.grossloss) + "|closed=" + str.tostring(zfClosed) + "|wins=" + str.tostring(strategy.wintrades) + "|losses=" + str.tostring(strategy.losstrades) + "|even=" + str.tostring(strategy.eventrades) + "|max_drawdown=" + zfNum(strategy.max_drawdown) + "|position=" + zfNum(strategy.position_size))
// Visual fallback: the same trades in one table (screenshot).
var table zfTable = table.new(position.top_right, 1, 22, bgcolor=color.white, border_color=color.gray, border_width=1)
if barstate.islastconfirmedhistory
    table.cell(zfTable, 0, 0, "ZF|Q12 closed=" + str.tostring(strategy.closedtrades) + " open=" + str.tostring(strategy.opentrades) + " net=" + zfNum(strategy.netprofit), text_color=color.black, text_size=size.small, text_halign=text.align_left)
    int zfRows = strategy.closedtrades > 20 ? 20 : strategy.closedtrades
    if zfRows > 0
        for i = 0 to zfRows - 1
            table.cell(zfTable, 0, i + 1, str.tostring(i) + " " + strategy.closedtrades.entry_id(i) + " size=" + zfNum(strategy.closedtrades.size(i)) + " in " + zfDate(strategy.closedtrades.entry_time(i)) + " @" + zfNum(strategy.closedtrades.entry_price(i)) + " out " + strategy.closedtrades.exit_id(i) + " " + zfDate(strategy.closedtrades.exit_time(i)) + " @" + zfNum(strategy.closedtrades.exit_price(i)) + " pnl=" + zfNum(strategy.closedtrades.profit(i)) + " comm=" + zfNum(strategy.closedtrades.commission(i)), text_color=color.black, text_size=size.small, text_halign=text.align_left)
    if strategy.opentrades > 0
        table.cell(zfTable, 0, 21, "OPEN " + strategy.opentrades.entry_id(0) + " size=" + zfNum(strategy.opentrades.size(0)) + " in " + zfDate(strategy.opentrades.entry_time(0)) + " @" + zfNum(strategy.opentrades.entry_price(0)), text_color=color.black, text_size=size.small, text_halign=text.align_left)
