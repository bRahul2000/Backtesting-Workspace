//@version=6
// Zoneflow P3.1 parity - STRATEGY ORACLE q14: v6 default margin (100%) and process_orders_on_close.
// Real TradingView is the oracle. Chart: BINANCE:BTCUSDT.P, 1D. Result: "List of trades" -> Download (CSV).
strategy("q14 strategy margin close", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed,
     default_qty_value=1, process_orders_on_close=true)
on(int y, int m, int d) => time == timestamp("UTC", y, m, d, 0, 0)

// M1 one contract (~100k USDT) with 10k of equity and 100% margin
if on(2025, 10, 1)
    strategy.entry("M1", strategy.long)
if on(2025, 10, 3)
    strategy.close_all()
// M2 0.05 contracts: fits; with process_orders_on_close the market order fills on the signal bar's close
if on(2025, 10, 6)
    strategy.entry("M2", strategy.long, qty = 0.05)
if on(2025, 10, 8)
    strategy.close_all()
// M3 buy stop below the close and M4 buy limit above the close, placed on the close
if on(2025, 10, 12)
    strategy.entry("M3", strategy.long, qty = 0.05, stop = close - 1000)
if on(2025, 10, 14)
    strategy.close_all()
if on(2025, 10, 18)
    strategy.entry("M4", strategy.long, qty = 0.05, limit = close + 1000)
if on(2025, 10, 20)
    strategy.close_all()
// M5 0.08 contracts (fits), then a second 0.08 entry (together more than the equity)
if on(2025, 10, 24)
    strategy.entry("M5a", strategy.long, qty = 0.08)
if on(2025, 10, 25)
    strategy.order("M5b", strategy.long, qty = 0.08)
if on(2025, 10, 28)
    strategy.close_all()
plot(strategy.position_size, "position size", display = display.data_window)

// ==== ZF observation block (added for Pine Logs; read-only: no order, setting or input changes) ====
// Emits one machine-readable Pine Logs line per trade on the last confirmed historical bar, prefix ZF|Q14|.
zfNum(float v) => na(v) ? "na" : str.tostring(v, "#.########")
zfDate(int t) => na(t) ? "na" : str.tostring(year(t, "UTC")) + "-" + (month(t, "UTC") < 10 ? "0" : "") + str.tostring(month(t, "UTC")) + "-" + (dayofmonth(t, "UTC") < 10 ? "0" : "") + str.tostring(dayofmonth(t, "UTC"))
if barstate.islastconfirmedhistory
    int zfClosed = strategy.closedtrades
    int zfOpen = strategy.opentrades
    log.info("ZF|Q14|BEGIN|closed=" + str.tostring(zfClosed) + "|open=" + str.tostring(zfOpen) + "|last_bar_time=" + str.tostring(time) + "|mintick=" + zfNum(syminfo.mintick))
    if zfClosed > 0
        for i = 0 to zfClosed - 1
            log.info("ZF|Q14|TRADE|" + str.tostring(i) + "|entry_id=" + strategy.closedtrades.entry_id(i) + "|size=" + zfNum(strategy.closedtrades.size(i)) + "|entry_time=" + str.tostring(strategy.closedtrades.entry_time(i)) + "|entry_bar=" + str.tostring(strategy.closedtrades.entry_bar_index(i)) + "|entry_price=" + zfNum(strategy.closedtrades.entry_price(i)) + "|exit_id=" + strategy.closedtrades.exit_id(i) + "|exit_time=" + str.tostring(strategy.closedtrades.exit_time(i)) + "|exit_bar=" + str.tostring(strategy.closedtrades.exit_bar_index(i)) + "|exit_price=" + zfNum(strategy.closedtrades.exit_price(i)) + "|profit=" + zfNum(strategy.closedtrades.profit(i)) + "|commission=" + zfNum(strategy.closedtrades.commission(i)) + "|runup=" + zfNum(strategy.closedtrades.max_runup(i)) + "|drawdown=" + zfNum(strategy.closedtrades.max_drawdown(i)))
    if zfOpen > 0
        for i = 0 to zfOpen - 1
            log.info("ZF|Q14|OPEN|" + str.tostring(i) + "|entry_id=" + strategy.opentrades.entry_id(i) + "|size=" + zfNum(strategy.opentrades.size(i)) + "|entry_time=" + str.tostring(strategy.opentrades.entry_time(i)) + "|entry_bar=" + str.tostring(strategy.opentrades.entry_bar_index(i)) + "|entry_price=" + zfNum(strategy.opentrades.entry_price(i)))
    log.info("ZF|Q14|SUMMARY|initial=" + zfNum(strategy.initial_capital) + "|equity=" + zfNum(strategy.equity) + "|net=" + zfNum(strategy.netprofit) + "|gross_profit=" + zfNum(strategy.grossprofit) + "|gross_loss=" + zfNum(strategy.grossloss) + "|closed=" + str.tostring(zfClosed) + "|wins=" + str.tostring(strategy.wintrades) + "|losses=" + str.tostring(strategy.losstrades) + "|even=" + str.tostring(strategy.eventrades) + "|max_drawdown=" + zfNum(strategy.max_drawdown) + "|position=" + zfNum(strategy.position_size))
// Visual fallback: the same trades in one table (screenshot).
var table zfTable = table.new(position.top_right, 1, 22, bgcolor=color.white, border_color=color.gray, border_width=1)
if barstate.islastconfirmedhistory
    table.cell(zfTable, 0, 0, "ZF|Q14 closed=" + str.tostring(strategy.closedtrades) + " open=" + str.tostring(strategy.opentrades) + " net=" + zfNum(strategy.netprofit), text_color=color.black, text_size=size.small, text_halign=text.align_left)
    int zfRows = strategy.closedtrades > 20 ? 20 : strategy.closedtrades
    if zfRows > 0
        for i = 0 to zfRows - 1
            table.cell(zfTable, 0, i + 1, str.tostring(i) + " " + strategy.closedtrades.entry_id(i) + " size=" + zfNum(strategy.closedtrades.size(i)) + " in " + zfDate(strategy.closedtrades.entry_time(i)) + " @" + zfNum(strategy.closedtrades.entry_price(i)) + " out " + strategy.closedtrades.exit_id(i) + " " + zfDate(strategy.closedtrades.exit_time(i)) + " @" + zfNum(strategy.closedtrades.exit_price(i)) + " pnl=" + zfNum(strategy.closedtrades.profit(i)) + " comm=" + zfNum(strategy.closedtrades.commission(i)), text_color=color.black, text_size=size.small, text_halign=text.align_left)
    if strategy.opentrades > 0
        table.cell(zfTable, 0, 21, "OPEN " + strategy.opentrades.entry_id(0) + " size=" + zfNum(strategy.opentrades.size(0)) + " in " + zfDate(strategy.opentrades.entry_time(0)) + " @" + zfNum(strategy.opentrades.entry_price(0)), text_color=color.black, text_size=size.small, text_halign=text.align_left)
